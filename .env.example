# Copy to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=EduPath API
DATABASE_URL=sqlite+pysqlite:///./edupath.db
SECRET_KEY=replace-this-with-a-unique-random-value-of-at-least-32-bytes
CORS_ORIGINS=
EDUPATH_PRIVATE_STORAGE_DIR=data/private_uploads
REDIS_URL=

# Auth defaults
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=3
AUTH_RATE_WINDOW_SECONDS=60

# Production example (use unique secrets and managed services):
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://edupath:change-me@localhost:5432/edupath
# SECRET_KEY=use-a-cryptographically-random-secret-of-at-least-32-bytes
# CORS_ORIGINS=https://your-frontend.example.com
# REDIS_URL=rediss://default:YOUR_PASSWORD@redis.example.com:6380/0
