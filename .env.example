# Copy to .env for local development. Never commit the real .env file.
APP_ENV=development
APP_NAME=EduPath API
DATABASE_URL=sqlite+pysqlite:///./edupath.db
SECRET_KEY=replace-this-with-a-unique-random-value-of-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173

# Production example (use unique secrets and your managed PostgreSQL service):
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://edupath:change-me@localhost:5432/edupath
# SECRET_KEY=use-a-cryptographically-random-secret-of-at-least-32-bytes
# CORS_ORIGINS=https://your-frontend.example.com
